# PRODUÇÃO — projeto GCP independente turni-prod, aplicado mas PARADO (custo ~zero).
# Copie para terraform.tfvars e preencha os valores reais. NUNCA commite terraform.tfvars.

project_id  = "turni-prod"
github_repo = "alcatechgroup/mvpturni-mvp"
alert_email = "xandroalmeida@gmail.com"

app_key_api   = "base64:GERE_COM_PHP_ARTISAN"
app_key_admin = "base64:GERE_COM_PHP_ARTISAN"
db_password   = "SENHA_FORTE_PROD_AQUI"

# E-mail transacional (ADR-011) — chave do Resend de PRODUÇÃO (não reusar homolog/stage)
resend_api_key = "re_CHAVE_RESEND_PROD_AQUI"

# Imagens de bootstrap (o pipeline sobrescreve no deploy). Enquanto parado, "hello" basta.
api_image   = "us-docker.pkg.dev/cloudrun/container/hello:latest"
admin_image = "us-docker.pkg.dev/cloudrun/container/hello:latest"

# Postura parada: false = recursos desligados (default). Só vira true no go-live (EPIC-006).
prod_live_enabled = false

# Delegação dos subdomínios na zona apex. Preencher com os `dns_name_servers` dos envs
# homolog (turni-homol) e stage (turni-stage) APÓS aplicá-los (2ª passada do apply do prod).
# delegations = {
#   "homolog.turni.com.br" = ["ns-cloud-a1.googledomains.com.", "ns-cloud-a2.googledomains.com.", "ns-cloud-a3.googledomains.com.", "ns-cloud-a4.googledomains.com."]
#   "stage.turni.com.br"   = ["ns-cloud-b1.googledomains.com.", "ns-cloud-b2.googledomains.com.", "ns-cloud-b3.googledomains.com.", "ns-cloud-b4.googledomains.com."]
# }
