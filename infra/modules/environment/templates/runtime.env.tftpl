# runtime.env — identidade NÃO-SECRETA do ambiente, gerada pelo Terraform e publicada
# no bucket de config. A VPS baixa este arquivo no boot e a cada deploy.
#
# NÃO coloque segredo aqui: o bucket é legível por quem tem storage.objectViewer no
# projeto. Segredo vive no Secret Manager e é injetado pelo scripts/render-env.sh,
# que concatena este arquivo com os valores buscados em runtime (ADR-004 §f).
#
# Gerado a partir de infra/modules/environment/templates/runtime.env.tftpl — não editar
# na VPS: o próximo `terraform apply` sobrescreve.

# ── Identidade do ambiente ───────────────────────────────────────────────────
TURNI_ENV=${business_env}
DEPLOY_ENV=${env}
GCP_PROJECT=${project_id}
GCP_REGION=${region}
SECRET_PREFIX=${name_prefix}

# ── Imagens ──────────────────────────────────────────────────────────────────
# IMAGE_TAG é sobrescrito pelo deploy.sh a cada release; `latest` só serve ao 1º boot.
REGISTRY=${registry}
IMAGE_TAG=${image_tag}

# ── Hosts públicos (subdomínios achatados — ADR-021 §c) ──────────────────────
WEBAPP_HOST=${webapp_host}
ADMIN_HOST=${admin_host}
API_HOST=${api_host}
LANDING_HOST=${landing_host}

# APP_URL das apps PHP aponta para a WebApp: é dela o link que vai nos e-mails
# transacionais (CTA "Acessar o Turni").
APP_URL=https://${webapp_host}

# ── Armazenamento ────────────────────────────────────────────────────────────
DATA_DIR=${data_dir}
CONFIG_BUCKET=${config_bucket}
BACKUP_BUCKET=${backups_bucket}

# ── Banco (Postgres no próprio host, rede interna do compose) ────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=${db_name}
DB_USERNAME=${db_user}

# ── E-mail transacional (ADR-011) ────────────────────────────────────────────
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=${mail_from_address}
MAIL_FROM_NAME=${mail_from_name}

# ── TLS ──────────────────────────────────────────────────────────────────────
# O Caddy resolve o desafio ACME por DNS-01 na Cloudflare (o firewall só aceita
# tráfego do proxy, então HTTP-01 não fecharia).
ACME_EMAIL=${acme_email}

# ── Gateway de pagamento (PDR-017 / ADR-016 d) ───────────────────────────────
PAGARME_DRIVER=mock
ENABLE_PAYMENT_FAKE=${enable_payment_fake}
PAGARME_BASE_URL=http://pagarme-mock:8080
PAGARME_MOCK_PIX_RESULTADO=${pagarme_mock_pix_resultado}
PAGARME_MOCK_PIX_SLA_SEGUNDOS=${pagarme_mock_pix_sla_segundos}
