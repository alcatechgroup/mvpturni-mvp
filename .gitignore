.DS_Store

# Segredos / ambiente — .env NUNCA é versionado; .env.example SIM (ADR-004)
.env
.env.*
!.env.example
apps/*/.env

# PHP / Laravel
/apps/*/vendor/
/packages/*/vendor/
/apps/*/storage/*.key
/apps/*/storage/logs/*
/apps/*/storage/framework/cache/data/*
/apps/*/storage/framework/sessions/*
/apps/*/storage/framework/views/*
/apps/*/bootstrap/cache/*.php
.phpunit.result.cache
.phpunit.cache/

# Flutter / Dart (WebApp)
/apps/webapp/.dart_tool/
/apps/webapp/build/
/apps/webapp/.flutter-plugins
/apps/webapp/.flutter-plugins-dependencies

# Node (tooling eventual)
node_modules/

# Cobertura
coverage/
clover.xml
coverage.xml

# Terraform — state e vars com segredos nunca versionados
infra/**/.terraform/
infra/**/.terraform.lock.hcl
infra/**/terraform.tfvars
infra/**/terraform.tfstate
infra/**/terraform.tfstate.backup
*.tfplan
# plano salvo (terraform plan -out=tfplan) — sem extensão; binário com snapshot de state/vars
tfplan
infra/**/tfplan


# Obsidian — estado local do editor (UI, painéis); reescrito a cada poucos segundos
.obsidian/


# Estado local do Claude Code (locks, tasks de runtime)
.claude/

# Binários de browser p/ E2E local (Chrome-for-Testing + chromedriver) — nunca commitar
chrome/
chromedriver/
