{
  "projects": {
    "default": "turni-homol",
    "homolog": "turni-homol",
    "stage": "turni-stage",
    "prod": "turni-prod"
  },
  "targets": {
    "turni-homol": {
      "hosting": {
        "homolog": ["turni-homol-webapp"],
        "landing-homolog": ["turni-homol-landing"]
      }
    },
    "turni-stage": {
      "hosting": {
        "stage": ["turni-webapp-stage"]
      }
    },
    "//": "Landing + redirect www de prod vivem no mesmo projeto turni-prod (migrados do workaround turni-prod-web em 2026-06, após o Firebase resolver o channel órfão 409). Site de redirect = turni-redirect-prod (Firebase rejeita 'www' no site_id).",
    "turni-prod": {
      "hosting": {
        "prod": ["turni-webapp-prod"],
        "landing-prod": ["turni-landing-prod"],
        "www-redirect-prod": ["turni-redirect-prod"]
      }
    }
  }
}
