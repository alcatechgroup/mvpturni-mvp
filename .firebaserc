{
  "projects": {
    "default": "turni-homol",
    "homolog": "turni-homol",
    "stage": "turni-stage",
    "prod": "turni-prod",
    "prod-web": "turni-prod-web"
  },
  "targets": {
    "turni-homol": {
      "hosting": {
        "homolog": ["turni-homol-webapp"],
        "landing-homolog": ["turni-homol-landing"]
      }
    },
    "turni-stage": {
      "hosting": {
        "stage": ["turni-webapp-stage"]
      }
    },
    "turni-prod": {
      "hosting": {
        "prod": ["turni-webapp-prod"]
      }
    },
    "//": "TEMPORÁRIO: a landing de prod vive no turni-prod-web porque o Firebase Hosting do turni-prod (projeto recuperado) está com channel órfão (409). Migrar de volta p/ turni-prod quando o suporte do Firebase limpar. Site de redirect = turni-redirect-prod (Firebase rejeita 'www' no site_id).",
    "turni-prod-web": {
      "hosting": {
        "landing-prod": ["turni-landing-prod"],
        "www-redirect-prod": ["turni-redirect-prod"]
      }
    }
  }
}
