# .env da RAIZ — consumido pelo docker-compose (substituição de ${VAR}) e pelo
# Terraform (token da Cloudflare).
# Copie para `.env` (o `make setup` faz isso quando ausente). NUNCA comite `.env`.
# Segredos reais de homolog/staging/prod vivem no Secret Manager (ADR-004/ADR-021),
# não aqui.

# --- Cloudflare (ADR-021) ---
# Token da API com permissão Zone:DNS:Edit em turni.com.br. Usado em DOIS lugares:
#   1. Terraform, para criar os registros A dos ambientes;
#   2. Caddy da VPS, para o desafio DNS-01 que emite os certificados TLS
#      (o valor é copiado para o Secret Manager pelo Terraform).
# Exportar antes do apply:
#   set -a && . .env && set +a && export TF_VAR_cloudflare_token="$CLOUDFLARE_TOKEN"
CLOUDFLARE_TOKEN=

# --- PostgreSQL (container local; nos ambientes, container na própria VPS) ---
POSTGRES_DB=turni
POSTGRES_USER=turni
POSTGRES_PASSWORD=turni
# Porta publicada no host (a interna do container é sempre 5432). 5433 evita o
# conflito comum com um PostgreSQL/Docker já ocupando a 5432 na máquina.
POSTGRES_PORT=5433

# --- Portas publicadas no host ---
API_PORT=8001
ADMIN_PORT=8002
WEBAPP_PORT=8003
PAGARME_MOCK_PORT=8090

# --- Pagar.me (ADR-005): mock local é o default; sandbox/live só em CI/ambientes ---
PAGARME_DRIVER=mock
